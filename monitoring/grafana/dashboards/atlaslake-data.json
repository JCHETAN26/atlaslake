      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (rate(atlas_stream_duplicate_events_total[5m])) * 60",
          "legendFormat": "{{topic}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
