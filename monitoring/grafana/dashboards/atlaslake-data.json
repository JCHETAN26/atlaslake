      "id": 5,
      "type": "timeseries",
      "title": "Duplicates detected (absorbed) /min",
      "description": "Physical duplicate deliveries caught by dedup \u2014 compare with 'leaked' (must stay 0).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
