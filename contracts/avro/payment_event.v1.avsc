{
  "type": "record",
  "name": "PaymentEvent",
  "namespace": "com.atlaslake.commerce",
  "doc": "Payment attempt event (topic commerce.payments).",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID, stable across redelivery"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      },
      "doc": "when the fact happened at the source (UTC)"
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "int"
    },
    {
      "name": "payment_id",
      "type": "string"
    },
    {
      "name": "order_id",
      "type": "string"
    },
    {
      "name": "attempt",
      "type": "int"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "amount_minor",
      "type": "long"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "method",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "failure_reason",
      "type": [
        "null",
        "string"
      ],
      "default": null
    }
  ]
}
