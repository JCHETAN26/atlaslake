{
  "type": "record",
  "name": "InventoryEvent",
  "namespace": "com.atlaslake.commerce",
  "doc": "Inventory delta event (topic commerce.inventory).",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID, stable across redelivery"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      },
      "doc": "when the fact happened at the source (UTC)"
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "int"
    },
    {
      "name": "inventory_key",
      "type": "string",
      "doc": "store_id:product_id"
    },
    {
      "name": "store_id",
      "type": "string"
    },
    {
      "name": "product_id",
      "type": "string"
    },
    {
      "name": "reason",
      "type": "string",
      "doc": "RESERVATION|SHIPMENT|RELEASE|RESTOCK"
    },
    {
      "name": "on_hand_delta",
      "type": "int"
    },
    {
      "name": "reserved_delta",
      "type": "int"
    },
    {
      "name": "order_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    }
  ]
}
