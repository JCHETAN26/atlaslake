{
  "type": "record",
  "name": "ProductEvent",
  "namespace": "com.atlaslake.commerce",
  "doc": "Product snapshot event (topic commerce.products).",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID, stable across redelivery"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      },
      "doc": "when the fact happened at the source (UTC)"
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "int"
    },
    {
      "name": "product_id",
      "type": "string"
    },
    {
      "name": "sku",
      "type": "string"
    },
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "category",
      "type": "string"
    },
    {
      "name": "unit_price_minor",
      "type": "long"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "active",
      "type": "boolean"
    }
  ]
}
