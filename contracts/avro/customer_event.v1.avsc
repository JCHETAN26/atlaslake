{
  "type": "record",
  "name": "CustomerEvent",
  "namespace": "com.atlaslake.commerce",
  "doc": "Customer snapshot event (topic commerce.customers); full state on every change.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID, stable across redelivery"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      },
      "doc": "when the fact happened at the source (UTC)"
    },
    {
      "name": "producer",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "int"
    },
    {
      "name": "customer_id",
      "type": "string"
    },
    {
      "name": "email",
      "type": "string",
      "doc": "PII: restricted"
    },
    {
      "name": "phone",
      "type": "string",
      "doc": "PII: restricted"
    },
    {
      "name": "first_name",
      "type": "string",
      "doc": "PII: confidential"
    },
    {
      "name": "last_name",
      "type": "string",
      "doc": "PII: confidential"
    },
    {
      "name": "city",
      "type": "string"
    },
    {
      "name": "state",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "country",
      "type": "string"
    },
    {
      "name": "segment",
      "type": "string"
    },
    {
      "name": "signup_timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      }
    }
  ]
}
